# ─────────────────────────────────────────────────────────────
# AutoNode environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://autonode:autonode@localhost:5432/autonode?schema=public

# ── Redis (BullMQ queues, caching, rate limiting) ─────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────
# 32+ char random string. Generate: openssl rand -base64 48
JWT_SECRET=change-me-super-secret-jwt-signing-key-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# AES-256-GCM key used to encrypt Meta access tokens at rest.
# Must decode to EXACTLY 32 bytes. Generate: openssl rand -base64 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=SAGL5nvR+Dz0vP37pY4Anu8tHMA/JFEwJOGHd3Suv/M=

# ── Meta (Instagram / Messenger / WhatsApp) ──────────────────
META_APP_ID=
META_APP_SECRET=
# Arbitrary string you also configure in the Meta App webhook UI.
META_VERIFY_TOKEN=autonode-verify-token
META_GRAPH_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/meta/oauth/callback

# Instagram API with Instagram Login — used for "Connect Instagram" (no Facebook
# Page required). Get these from Meta App → Instagram → API setup with Instagram
# login. Register META_OAUTH_REDIRECT_URI as a valid OAuth redirect URI there.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── AI ────────────────────────────────────────────────────────
# Which provider the abstraction layer uses by default: openai | anthropic
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── API server ────────────────────────────────────────────────
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ── Web app ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── Stripe (billing) ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs for subscription plans
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
# Public URL for Stripe success/cancel redirects
APP_URL=http://localhost:3000

# ── Resend (transactional email) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=AutoNode <noreply@autonode.app>
